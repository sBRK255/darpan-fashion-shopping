4 List Transactions
GET /api/list-transaction

Retrieve a list of transactions within a specified date range.
Query Parameters
Parameter 	Type 	Required 	Description
date_from 	String 	Yes 	Start date (YYYY-MM-DD format)
date_to 	String 	Yes 	End date (YYYY-MM-DD format)
Code Examples

const https = require('https');

const options = {
  hostname: 'https://api.fastlipa.com'.replace('https://', ''),
  path: '/api/list-transaction?date_from=2025-09-01&date_to=2025-09-05',
  method: 'GET',
  headers: {
    'Authorization': 'Bearer YOUR_API_TOKEN'
  }
};

const req = https.request(options, res => {
  let data = '';
  res.on('data', chunk => data += chunk);
  res.on('end', () => console.log(JSON.parse(data)));
});

req.end();

